# Local-only lab profile. SNMPv3 (default) or SNMPv2c; never commit .env.snmp.
SNMP_VERSION=3
# For v2c, choose a private read-only community (never use public/default).
SNMP_COMMUNITY=
# Lab-only SNMPv3 credentials. Copy to .env.snmp; do not commit .env.snmp.
SNMP_V3_USERNAME=lab_readonly
SNMP_V3_AUTH_KEY=CHANGE_TO_A_PRIVATE_AUTH_KEY
SNMP_V3_PRIV_KEY=CHANGE_TO_A_DIFFERENT_PRIV_KEY
SNMP_EMULATOR_SCENARIO=NORMAL
SNMP_AGENT_UPDATE_MS=1000
# Set ELTEK_BDCBB_CONFIG_2 for two A/B linked-panel shunts, or ELTEK_BDCBB_CONFIG_4 for four independent A1/A2/B1/B2 shunts.
SNMP_EMULATOR_PROFILE=GENERIC_2_FEED
